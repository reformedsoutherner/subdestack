{
  "manifest_version": 3,
  "name": "Substack Note Scheduler",
  "version": "1.0.0",
  "description": "Schedule your Substack notes for future publishing",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": ["https://*.substack.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.substack.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Substack Note Scheduler",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
